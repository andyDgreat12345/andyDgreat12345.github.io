---
import Base from '../layouts/Base.astro';
import ProjectBlock from '../components/ProjectBlock.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Projects" description="Projects by Andy Sun — hardware, 3D graphics, and the web.">
  <section class="hero" style="padding-bottom:8px">
    <p class="eyebrow">Projects</p>
    <h1>Things I've built.</h1>
    <p class="lead">Hardware, 3D graphics, and a decade of tinkering on the web.</p>
  </section>

  <div class="projects-list">
    {projects.map((p, i) => <ProjectBlock project={p} idx={i + 1} />)}
    {projects.length === 0 && <p class="muted">No projects yet.</p>}
  </div>
</Base>
