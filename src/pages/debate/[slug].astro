---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('debate');
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const base = import.meta.env.BASE_URL;
const path = (p: string) => `${base}${p}`.replace(/\/{2,}/g, '/');
const fmt = (d?: Date) =>
  d ? d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }) : '';
---

<Base title={post.data.title} description={post.data.summary}>
  <article class="post">
    <a class="back small" href={path('debate')}>&larr; Debate</a>
    <h1>{post.data.title}</h1>
    <div class="meta small muted">
      {post.data.date && <span>{fmt(post.data.date)}</span>}
      <span class="kindtag">{post.data.kind === 'results' ? 'results' : 'method'}</span>
    </div>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style is:global>
  .post { padding: 40px 0 20px; }
  .post .back { display: inline-block; margin-bottom: 18px; }
  .post .meta { display: flex; gap: 12px; align-items: center; margin-bottom: 28px; }
  .kindtag {
    font-family: var(--mono); font-size: .7rem;
    padding: 2px 9px; border-radius: 999px;
    background: var(--accent-soft); color: var(--accent);
  }
  .prose { font-size: 1.03rem; }
  .prose h2 { margin-top: 2rem; }
  .prose h3 { margin-top: 1.6rem; font-size: 1.1rem; }
  .prose ul, .prose ol { padding-left: 1.3rem; }
  .prose li { margin-bottom: .4rem; }
  .prose blockquote {
    border-left: 3px solid var(--accent);
    margin: 1.2rem 0; padding: .4rem 1.1rem;
    background: var(--bg-soft); border-radius: 6px;
    color: var(--text-soft);
  }
  .prose code {
    font-family: var(--mono); font-size: .85em;
    background: var(--bg-soft); padding: 1px 6px; border-radius: 5px;
  }
  .prose strong { color: var(--text); }
  .prose em { color: var(--text-soft); }
</style>
