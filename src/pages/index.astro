---
import Base from '../layouts/Base.astro';
import ProjectBlock from '../components/ProjectBlock.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const path = (p: string) => `${base}${p}`.replace(/\/{2,}/g, '/');

// ---- EDIT THESE: your identity + top links ----
const NAME = 'Andy Sun';
const TAGLINE = 'Student, debater, and builder — I make hardware, 3D graphics, and things for the web.';
const GITHUB = 'https://github.com/andyDgreat12345';
const LINKEDIN = ''; // ← paste your LinkedIn profile URL to show the button
const EMAIL = 'ryanasdspi@gmail.com';
// ------------------------------------------------

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = all.filter((p) => p.data.featured);
const shown = featured.length ? featured : all.slice(0, 3);
---

<Base title={NAME} description={`${NAME} — ${TAGLINE}`}>
  <section class="hero">
    <p class="eyebrow">Andy Sun · Student · Builder</p>
    <h1>{NAME}<span class="accent-dot">.</span></h1>
    <p class="lead">{TAGLINE}</p>
    <div class="links-row">
      <a class="btn primary" href={GITHUB} target="_blank" rel="noopener">GitHub</a>
      {LINKEDIN && <a class="btn" href={LINKEDIN} target="_blank" rel="noopener">LinkedIn</a>}
      <a class="btn" href={`mailto:${EMAIL}`}>Email</a>
      <a class="btn" href={path('projects')}>Projects</a>
    </div>
  </section>

  <section>
    <div class="section-head">
      <h2>Selected work</h2>
      <a href={path('projects')}>All projects →</a>
    </div>
    <div class="projects-list">
      {shown.map((p, i) => <ProjectBlock project={p} idx={i + 1} />)}
    </div>
  </section>
</Base>
