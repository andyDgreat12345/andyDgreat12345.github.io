---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const path = (p: string) => `${base}${p}`.replace(/\/{2,}/g, '/');

// ---- EDIT THESE: your identity + top links ----
const NAME = 'Andy';
const TAGLINE = 'Student, debater, and builder. A running record of what I make.';
const GITHUB = 'https://github.com/andyDgreat12345';
const EMAIL = 'ryanasdspi@gmail.com';
// ------------------------------------------------

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order);

const fmt = (d?: Date) => d ? d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', timeZone: 'UTC' }) : '';
---

<Base title={NAME}>
  <section class="hero">
    <h1>{NAME}</h1>
    <p class="lead">{TAGLINE}</p>
    <div class="links-row">
      <a class="btn primary" href={GITHUB} target="_blank" rel="noopener">GitHub</a>
      <a class="btn" href={`mailto:${EMAIL}`}>Email</a>
      <a class="btn" href={path('projects')}>All projects →</a>
    </div>
  </section>

  <section>
    <div class="section-head">
      <h2>Projects</h2>
      <a href={path('projects')}>See all</a>
    </div>
    <div class="grid">
      {projects.map((p) => (
        <article class="card">
          <h3>{p.data.title}</h3>
          {p.data.date && <div class="meta">{fmt(p.data.date)}</div>}
          <p>{p.data.summary}</p>
          {p.data.tags.length > 0 && (
            <div class="tags">{p.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
          )}
          <div class="card-links">
            {p.data.repo && <a href={p.data.repo} target="_blank" rel="noopener">Code ↗</a>}
            {p.data.website && <a href={p.data.website} target="_blank" rel="noopener">Live site ↗</a>}
          </div>
        </article>
      ))}
    </div>
  </section>
</Base>
